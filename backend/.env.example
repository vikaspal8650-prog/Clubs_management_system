PORT=3001
DATABASE_URL="postgresql://<username>:<password>@<host>:5432/<database>?schema=public"
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<generate-a-unique-secret-at-least-32-characters>"
FRONTEND_ORIGIN="http://localhost:3000"
COOKIE_SAME_SITE="lax"
# Use "none" only when frontend/backend are on different sites; requires HTTPS.
COOKIE_DOMAIN=""
RATE_LIMIT_KEY_SECRET="<set-an-independent-high-entropy-secret>"
# Set a persistent disk mount path in production; local development defaults to OS temp storage.
UPLOAD_DIR=""
SEED_USER_PASSWORD="<set-a-strong-password-before-seeding>"
